@startuml
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam useCaseBorderColor #2E86C1
skinparam useCaseBackgroundColor #EBF5FB
skinparam useCaseFontColor #1A5276
skinparam useCaseFontSize 14
skinparam actorBorderColor #2E86C1
skinparam actorBackgroundColor #AED6F1
skinparam actorFontSize 14
skinparam defaultFontSize 13
skinparam arrowColor #2E86C1
skinparam defaultTextAlignment center
skinparam padding 20

title **Atendente**

rectangle "AV-CAR Auto Center" {
  (Cadastrar Cliente PF) as UC1
  (Cadastrar Cliente PJ) as UC2
  (Buscar/Editar Cliente) as UC3
  (Cadastrar Veiculo) as UC4
  (Vincular Cliente-Veiculo) as UC5
  (Consultar Estoque) as UC9
  (Abrir Ordem de Servico) as UC11
  (Finalizar OS) as UC14
  (Consultar Historico) as UC19
}

actor Atendente as ate

ate --> UC1
ate --> UC2
ate --> UC3
ate --> UC4
ate --> UC5
ate --> UC9
ate --> UC11
ate --> UC14
ate --> UC19

@enduml
